# Database configuration (MySQL with PyMySQL)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/patient_case_system

# Authentication / Security
SECRET_KEY=your_secure_random_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration (Google Gemini / OpenAI / Anthropic)
AI_PROVIDER=gemini
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-1.5-flash

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173

# Emergency Guidance Configuration (Default: India)
EMERGENCY_COUNTRY=India
PRIMARY_EMERGENCY_NUMBER=112
AMBULANCE_EMERGENCY_NUMBER=108
